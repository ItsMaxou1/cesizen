# Exemple pour lancer la stack en local (copier en infra/local.env, jamais commité) :
#   docker compose --env-file infra/local.env -f infra/docker-compose.yml up -d
# En recette / production, ces valeurs sont fournies par les environnements GitHub.
COMPOSE_PROJECT_NAME=cesizen-local
REGISTRY=ghcr.io/itsmaxou1
API_TAG=develop
WEB_TAG=develop
WEB_PORT=8081
MYSQL_PASSWORD=changer-moi
MYSQL_ROOT_PASSWORD=changer-moi-aussi
JWT_SECRET=une-longue-chaine-aleatoire-de-64-caracteres
CORS_ORIGINS=http://localhost:8081
